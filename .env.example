# Vendor-Aware Troubleshooting (VAT) Configuration Template
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL pgvector Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vat
POSTGRES_USER=vat
POSTGRES_PASSWORD=vat_password
DATABASE_URL=postgresql://vat:vat_password@localhost:5432/vat

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Inference (Optional: GitHub Models / OpenAI Compatible API)
GITHUB_TOKEN=
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://models.inference.ai.azure.com
